# Database configuration (Defaults to SQLite; easily switch to PostgreSQL by setting DATABASE_URL)
DATABASE_URL=sqlite:///./evcsms.db
# For PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/evcsms_db

# JWT Security
SECRET_KEY=evcsms_super_secret_jwt_key_2026_modern_oosmd_enterprise_grade
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App Settings
PROJECT_NAME="EV Charging Station Management System"
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Scheduler settings
SCHEDULER_INTERVAL_SECONDS=60
BOOKING_EXPIRATION_MINUTES=10
REMINDER_MINUTES_BEFORE=15
